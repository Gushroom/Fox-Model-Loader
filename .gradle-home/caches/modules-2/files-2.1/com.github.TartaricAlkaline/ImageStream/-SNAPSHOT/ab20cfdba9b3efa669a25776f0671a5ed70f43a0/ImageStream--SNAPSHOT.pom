  <inceptionYear>2026</inceptionYear>
  <developers>
    <developer>
      <id>TartaricAlkaline</id>
      <name></name>
      <email></email>
    </developer>
  </developers>
  <scm>
    <connection>scm:git://github.com/TartaricAlkaline/ImageStream.git</connection>
    <developerConnection>scm:git://github.com/TartaricAlkaline/ImageStream.git</developerConnection>
    <url>git://github.com/TartaricAlkaline/ImageStream.git</url>
